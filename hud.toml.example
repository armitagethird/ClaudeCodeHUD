# HUD — configuração opcional. Copie para  ~/.claude/hud.toml  e ajuste.
# Todos os campos são opcionais; o que faltar usa o default embutido.
# Qualquer erro de parse faz o HUD cair nos defaults (nunca quebra a statusline).

ascii_mode  = false        # true => medidor [#----] em vez de bloco ▓░
gauge_width = 16           # largura do medidor de contexto
separator   = "  ·  "      # separador entre segmentos
load_medio  = 50.0         # % de contexto p/ carga MÉDIO (use decimal)
load_alto   = 80.0         # % de contexto p/ carga ALTO  (use decimal)

# Ordem e ativação dos segmentos (esquerda → direita).
# Remova itens que não quiser. Em terminal estreito, os de menor prioridade
# (timer → branch → rate_limit → cost → tokens → load → effort) são ocultados
# primeiro; "model" e "context_gauge" são sempre preservados.
segments = ["model", "effort", "context_gauge", "tokens", "load", "cost", "rate_limit", "branch", "timer"]

[colors]                   # códigos ANSI 256
ok   = 2                   # verde   (carga leve)
warn = 3                   # amarelo (carga média)
crit = 1                   # vermelho (carga alta)
dim  = 8                   # cinza   (rótulos)

[model_names]              # id do modelo → rótulo exibido
"claude-opus-4-8"            = "Opus 4.8"
"claude-sonnet-4-6"          = "Sonnet 4.6"
"claude-haiku-4-5-20251001"  = "Haiku 4.5"
"claude-fable-5"             = "Fable 5"
